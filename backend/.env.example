PORT=4000
NODE_ENV=development
LOG_LEVEL=info
TRUST_PROXY=0

# Neon (and similar): use the pooler host if available, and cap connections — e.g.
# postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15&connection_limit=5
# If you hit "max clients reached" / pool_size 15, lower connection_limit or reduce concurrent API traffic until the DB tier allows more.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
REDIS_URL=redis://default:PASSWORD@HOST:6379

JWT_ACCESS_SECRET=replace-with-long-random-secret-min-16-chars
JWT_REFRESH_SECRET=replace-with-long-random-secret-min-16-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Must match the bucket's AWS region (not a generic AWS_REGION alias).
S3_REGION=us-east-1
S3_BUCKET=prochef-scans
# MinIO (docker compose -f docker-compose.dev.yml): http://127.0.0.1:9000
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring Price IDs from Stripe Dashboard ($7.99/mo and $54.99/yr products)
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=
# Mobile deep links for Checkout return (must include {CHECKOUT_SESSION_ID} in success URL if you pass session_id)
CHECKOUT_SUCCESS_URL=prochef://billing/success?session_id={CHECKOUT_SESSION_ID}
CHECKOUT_CANCEL_URL=prochef://billing/cancel

# Optional tuning (see docs/hardening-phase7.md)
# RATE_LIMIT_GLOBAL_MAX=500
# RATE_LIMIT_GLOBAL_WINDOW_MS=900000
# RATE_LIMIT_AUTH_MAX=20
# RATE_LIMIT_AUTH_WINDOW_MS=900000
