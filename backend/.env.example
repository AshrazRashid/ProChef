PORT=4000
NODE_ENV=development
LOG_LEVEL=info
TRUST_PROXY=0

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
REDIS_URL=redis://default:PASSWORD@HOST:6379

JWT_ACCESS_SECRET=replace-with-long-random-secret-min-16-chars
JWT_REFRESH_SECRET=replace-with-long-random-secret-min-16-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

S3_REGION=us-east-1
S3_BUCKET=prochef-scans
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional tuning (see docs/hardening-phase7.md)
# RATE_LIMIT_GLOBAL_MAX=500
# RATE_LIMIT_GLOBAL_WINDOW_MS=900000
# RATE_LIMIT_AUTH_MAX=20
# RATE_LIMIT_AUTH_WINDOW_MS=900000
